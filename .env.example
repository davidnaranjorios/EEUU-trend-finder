# Copia a .env y rellena. .env no se versiona.
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
CENSUS_API_KEY=
# SEC exige nombre y correo de contacto en el User-Agent
SEC_USER_AGENT="Nombre Apellido correo@ejemplo.com"
# Cloudflare R2 (ADR 0002): token con permiso de lectura/escritura solo sobre el bucket.
# Nombres estándar de S3: los leen rclone (infra/sync_r2.sh) y DuckDB (src/catalog.py).
CLOUDFLARE_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
